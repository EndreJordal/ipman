{
  "name": "ipman",
  "private": true,
  "version": "0.2.1",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "hls.js": "^1.7.3",
    "htmlparser2": "^12.0.0",
    "idb-keyval": "^6.3.0",
    "mpegts.js": "^1.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build",
    "start": "vite build --logLevel warn && node server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test:e2e": "node tests/e2e.mjs",
    "package": "node scripts/package.mjs"
  }
}
